# Kopiervorlage für /etc/ela-bridge/bridge.env
# Diese Datei enthält Passwörter und gehört NICHT ins Repository.
# Rechte: sudo chown root:ela-bridge /etc/ela-bridge/bridge.env && sudo chmod 640 /etc/ela-bridge/bridge.env

# Datenbank (eigener Benutzer mit minimalen Rechten, siehe README)
ELA_DB_HOST=127.0.0.1
ELA_DB_PORT=3306
ELA_DB_NAME=ela
ELA_BRIDGE_DB_USER=ela_bridge
ELA_BRIDGE_DB_PASSWORD=HIER_PASSWORT_EINTRAGEN

# MQTT-Broker (Mosquitto)
ELA_MQTT_HOST=127.0.0.1
ELA_MQTT_PORT=1883
ELA_MQTT_USER=ela-bridge
ELA_MQTT_PASSWORD=HIER_PASSWORT_EINTRAGEN
ELA_MQTT_CLIENT_ID=ela-bridge

# INFO oder DEBUG
ELA_BRIDGE_LOG_LEVEL=INFO
